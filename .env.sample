# ════════════════════════════════════════════════════════════════════
# Urdu Audio-to-Text Transcription — Configuration
# Copy this file to .env and edit values as needed. All settings can also
# be overridden via environment variables or CLI flags / config file.
# ════════════════════════════════════════════════════════════════════

# ── Model Selection ────────────────────────────────────────────────
# Main model used for Urdu transcription (auto-selected if QUALITY_PRESET=turbo).
HF_MODEL_ID=kingabzpro/whisper-large-v3-turbo-urdu
# Fastest quality preset — lower accuracy (English). Set --quality fast to use.
FAST_MODEL=distil-whisper/distil-medium.en
# Default quality preset — Urdu-optimized, balanced speed/accuracy.
TURBO_MODEL=kingabzpro/whisper-large-v3-turbo-urdu
# Slowest preset — highest accuracy (multilingual). Set --quality accurate to use.
ACCURATE_MODEL=openai/whisper-large-v3-turbo

# ── Default Settings ───────────────────────────────────────────────
# Language code for transcription: ur, en, hi, ar, es, fr, de, ja, ko, zh, pt, ru, etc.
DEFAULT_LANGUAGE=urdu
# Output format: txt, json, jsonl, docx
DEFAULT_FORMAT=txt
# Speed/quality preset: fast, turbo, accurate
QUALITY_PRESET=turbo
# Auto-add Urdu sentence-ending punctuation (periods) after common patterns
AUTO_PUNCTUATE=true
# Apply dictionary + pattern-based Urdu spell correction
AUTO_SPELL=true
# Maximum audio segment length in minutes before Whisper splits internally
MAX_SEGMENT_MINUTES=30

# ── Parallel Processing (BATCH mode) ───────────────────────────────
# Multi-process batch parallelism (GPU mode remains single-process).
PARALLEL_ENABLED=true
# Absolute worker cap (0 = auto-detect based on CPU count)
MAX_WORKERS=0
# Workers spawned per CPU core (minimum 1)
WORKERS_PER_CPU=1

# ── Chunking for Long Audio (YouTube / long files > threshold) ─────
# Duration of each audio chunk in seconds. Must be <= Whisper's default segment size (~30s).
# Each chunk maps to ONE Whisper internal segment — no internal boundaries = no gaps.
CHUNK_DURATION_S=30
# Overlap between consecutive chunks in seconds. Generous overlap ensures tail-end content losses from one chunk are fully captured at the start of the next (Whisper is most reliable at segment starts).
CHUNK_OVERLAP_S=1
# Files longer than this threshold (seconds) trigger automatic chunking.
MAX_AUDIO_BEFORE_SPLIT_S=60

# ── Text Deduplication ─────────────────────────────────────────────
# Min consecutive matching words required before overlap trimming is applied.
# When chunks have < this many identical consecutive words at the boundary,
# nothing is trimmed (all content is preserved). Higher = more conservative.
MIN_OVERLAP_MATCH=5

# ── Low-RAM Mode & Memory Allocation ───────────────────────────────
# Auto-detect (< 8 GB RAM) or manual override (true/false).
LOW_RAM=auto
# Total memory budget in MB for the transcriber app. The model alone needs ~1.6 GB.
# Recommended: 2048 (sequential only), 4096 (up to 2 workers), 8192 (up to 4 workers).
RAM_ALLOCATION_MB=8192
# Memory per parallel worker in MB (each loads a model copy). Total = WORKER_MEMORY_MB x max_workers.
WORKER_MEMORY_MB=6144

# ── Audio ───────────────────────────────────────────────────────────
# File extensions recognized for batch transcription.
SUPPORTED_EXTENSIONS=.mp3,.wav,.flac,.ogg,.m4a,.mp4,.webm,.aac,.wma
# Skip files shorter than this (seconds) — avoid silence/noise.
MIN_AUDIO_DURATION_S=10
# Minimum valid audio duration for YouTube downloads (seconds).
YOUTUBE_MIN_DURATION_S=10
# Audio formats yt-dlp is allowed to download from YouTube.
YOUTUBE_AUDIO_EXTENSIONS=.mp3,.wav,.flac,.ogg,.m4a,.aac

# ── Output Paths ────────────────────────────────────────────────────
# Directory where downloaded YouTube audio is saved.
YOUTUBE_OUTPUT_DIR=youtube_downloads
# Hash-based cache preventing re-transcription of same files.
CACHE_FILE=.transcribe_cache.json
# Persistent CLI config (model, language, format, etc.).
CONFIG_FILE=transcribe_config.json
# Resume state — tracks completed batch files for restart.
BATCH_STATUS_FILE=.batch_status.json

# ── YouTube / yt-dlp ───────────────────────────────────────────────
# Suppress yt-dlp progress bar (non-interactive mode).
YTDLP_NO_PROGRESS=1

# ── App Info ────────────────────────────────────────────────────────
# Application version string.
APP_VERSION=2.0.0
