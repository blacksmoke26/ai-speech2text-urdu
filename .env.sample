# ════════════════════════════════════════════════════════════════════
# Urdu Audio-to-Text Transcription — Configuration
# All settings can be overridden via environment variables.
# ════════════════════════════════════════════════════════════════════

# ── Model ───────────────────────────────────────────────────────────
HF_MODEL_ID=kingabzpro/whisper-large-v3-turbo-urdu
FAST_MODEL=distil-whisper/distil-medium.en
TURBO_MODEL=kingabzpro/whisper-large-v3-turbo-urdu
ACCURATE_MODEL=openai/whisper-large-v3-turbo

# ── Default Settings ────────────────────────────────────────────────
DEFAULT_LANGUAGE=ur
DEFAULT_FORMAT=txt
QUALITY_PRESET=turbo
AUTO_PUNCTUATE=true
AUTO_SPELL=true
MAX_SEGMENT_MINUTES=30

# ── Parallel Processing (BATCH mode) ────────────────────────────────
# Control how many processes run in parallel for batch transcription.
# PARALLEL_ENABLED=false   → disable parallel entirely (sequential)
# MAX_WORKERS=N            → absolute cap on workers (0 = auto)
# WORKERS_PER_CPU=N        → workers per CPU core (default: 1)
PARALLEL_ENABLED=true
MAX_WORKERS=0
WORKERS_PER_CPU=1

# ── Chunking for Long Audio (YouTube / long files) ──────────────────
CHUNK_DURATION_S=60
CHUNK_OVERLAP_S=3
MAX_AUDIO_BEFORE_SPLIT_S=60

# ── Low-RAM Mode & Memory Allocation ────────────────────────────────
# AUTO-DETECT: Set to auto/true to enable based on system RAM (< 8 GB)
# Manual override: LOW_RAM=true or LOW_RAM=false
LOW_RAM=auto

# Total usable memory in MB that the transcriber may use (RAM allocated to this app).
# Must be less than total system RAM. A ~1.6GB model + overhead needs:
#   2048 MB → sequential only, safest for low-RAM
#   4096 MB → up to 2 workers
#   8192 MB → up to 4 workers
# Default: auto-detected (total system RAM minus 2 GB reserved for OS)
RAM_ALLOCATION_MB=8192

# Per-worker memory in MB. Each parallel worker loads one model copy.
# Total needed = WORKER_MEMORY_MB × max_workers. Keep under RAM_ALLOCATION_MB.
WORKER_MEMORY_MB=6144

# ── Audio ───────────────────────────────────────────────────────────
SUPPORTED_EXTENSIONS=.mp3,.wav,.flac,.ogg,.m4a,.mp4,.webm,.aac,.wma
MIN_AUDIO_DURATION_S=10
YOUTUBE_MIN_DURATION_S=10
YOUTUBE_AUDIO_EXTENSIONS=.mp3,.wav,.flac,.ogg,.m4a,.aac

# ── Output ──────────────────────────────────────────────────────────
YOUTUBE_OUTPUT_DIR=youtube_downloads
CACHE_FILE=.transcribe_cache.json
CONFIG_FILE=transcribe_config.json
BATCH_STATUS_FILE=.batch_status.json

# ── YouTube / yt-dlp ────────────────────────────────────────────────
YTDLP_NO_PROGRESS=1

# ── App Info ────────────────────────────────────────────────────────
APP_VERSION=2.0.0
